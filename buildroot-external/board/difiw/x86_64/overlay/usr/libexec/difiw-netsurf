#!/bin/sh
# Starts the NetSurf web engine inside a Difiw desktop window (HOME is the per-app home).
mkdir -p "$HOME/.netsurf"
if [ ! -f "$HOME/.netsurf/Choices" ]; then
cat > "$HOME/.netsurf/Choices" <<CHO
accept_language:ru,en;q=0.8
homepage_url:https://duckduckgo.com/html/
font_size:160
font_min_size:90
fb_font_monochrome:0
CHO
fi
exec /usr/bin/netsurf-fb -f ram -w 1000 -h 620 "${1:-https://duckduckgo.com/html/}"
