# Difiw OS 0.1.0 Core - BusyBox init
# Boot: kernel -> initramfs -> /init (BusyBox) -> this file.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t devtmpfs devtmpfs /dev
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Difiw Shell on the VGA/VirtualBox console. S10difiw-boot adds a ttyS0 line
# when a real serial port exists (QEMU), so VirtualBox does not respawn-loop.
tty1::respawn:/usr/libexec/difiw-session

::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
