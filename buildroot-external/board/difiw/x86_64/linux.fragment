# Difiw OS Core - kernel options merged on top of the x86_64 defconfig.
# Branding is done through the version suffix only; kernel sources stay untouched.
CONFIG_LOCALVERSION="-difiw"
# CONFIG_LOCALVERSION_AUTO is not set
# Boot from an initramfs (gzip) loaded by GRUB
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
# Consoles: VGA text/VT for VirtualBox, 16550 serial for QEMU automation
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_PRINTK=y
# Hardware seen in VirtualBox / QEMU
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# Optional DIFIWDATA disk (ext4) and ISO media
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
# Graphical shell: VESA framebuffer (mode set by GRUB), framebuffer console, evdev input
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
