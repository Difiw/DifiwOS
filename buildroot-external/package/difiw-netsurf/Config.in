config BR2_PACKAGE_DIFIW_NETSURF
	bool "difiw-netsurf"
	depends on BR2_PACKAGE_DIFIW_DESKTOP
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_DEJAVU
	help
	  NetSurf 3.11 web engine (CSS layout, HTTPS, images, forms) with a
	  libnsfb surface that draws into a Difiw desktop window.
	  Built by scripts/netsurf-build.sh (needs flex, bison, gperf, perl
	  and libpng headers on the build host).
