BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TARGET_GENERIC_HOSTNAME="difiw"
BR2_TARGET_GENERIC_ISSUE="Difiw OS 0.4.0 Core"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DIFIW_PATH)/board/difiw/x86_64/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DIFIW_PATH)/board/difiw/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DIFIW_PATH)/board/difiw/x86_64/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DIFIW_PATH)/board/difiw/x86_64/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DIFIW_PATH)/board/difiw/x86_64/busybox.fragment"
BR2_PACKAGE_KBD=y
BR2_PACKAGE_DIFIW_SHELL=y
BR2_PACKAGE_DIFIW_DESKTOP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
